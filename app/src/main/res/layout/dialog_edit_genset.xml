<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- GENSET 1 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="GENSET 1"
        android:textColor="@color/brand_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView style="@style/FieldLabel" android:text="Merk Genset 1" />
    <Spinner android:id="@+id/spMerkGenset1" style="@style/SpinnerField" />

    <TextView style="@style/FieldLabel" android:text="Capacity 1 (kVA)" />
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="@color/brand_primary">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCapacityGenset1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Capacity"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/FieldLabel" android:text="Status Genset 1" />
    <Spinner android:id="@+id/spStatusGenset1" style="@style/SpinnerField" />

    <TextView style="@style/FieldLabel" android:text="Remark Genset 1" />
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="@color/brand_primary">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRemarkGenset1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remark"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAdaGenset2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ada Genset 2?" />

    <LinearLayout
        android:id="@+id/layoutGenset2Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- GENSET 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="GENSET 2"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView style="@style/FieldLabel" android:text="Merk Genset 2" />
        <Spinner android:id="@+id/spMerkGenset2" style="@style/SpinnerField" />

        <TextView style="@style/FieldLabel" android:text="Capacity 2 (kVA)" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/brand_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCapacityGenset2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Capacity"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/FieldLabel" android:text="Status Genset 2" />
        <Spinner android:id="@+id/spStatusGenset2" style="@style/SpinnerField" />

        <TextView style="@style/FieldLabel" android:text="Remark Genset 2" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/brand_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRemarkGenset2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Remark"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</LinearLayout>