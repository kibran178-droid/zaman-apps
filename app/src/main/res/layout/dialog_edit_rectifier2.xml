<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Type Rectifier -->
    <TextView
        style="@style/FieldLabel"
        android:text="Type Rectifier #2" />

    <Spinner
        android:id="@+id/spTypeRectifier2"
        style="@style/SpinnerField" />

    <!-- Jumlah Modul & Rusak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="Jumlah Modul" />

            <Spinner
                android:id="@+id/spJumlahModul2"
                style="@style/SpinnerField" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="Modul Rusak" />

            <Spinner
                android:id="@+id/spJumlahModulRusak2"
                style="@style/SpinnerField" />
        </LinearLayout>
    </LinearLayout>

    <!-- Jenis Baterai -->
    <TextView
        style="@style/FieldLabel"
        android:text="Jenis Baterai #2" />

    <Spinner
        android:id="@+id/spJenisBaterai2"
        style="@style/SpinnerField" />

    <!-- Merk Baterai -->
    <TextView
        style="@style/FieldLabel"
        android:text="Merk Baterai #2" />

    <Spinner
        android:id="@+id/spMerkBaterai2"
        style="@style/SpinnerField" />

    <!-- Jumlah Battery -->
    <TextView
        style="@style/FieldLabel"
        android:text="Jumlah Battery (P)" />

    <Spinner
        android:id="@+id/spJumlahBattery2"
        style="@style/SpinnerField" />

    <TextView
        style="@style/FieldLabel"
        android:text="Battery Recti 2" />

    <Spinner
        android:id="@+id/spBatteryRecti2"
        style="@style/SpinnerField" />

    <!-- Bus Voltage -->
    <TextView
        style="@style/FieldLabel"
        android:text="Bus Voltage #2" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editBusVoltage2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bus Voltage"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Load (A) -->
    <TextView
        style="@style/FieldLabel"
        android:text="Load (A) #2" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLoadA2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Load (A)"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Perangkat Terhubung -->
    <TextView
        style="@style/FieldLabel"
        android:text="Perangkat Terhubung #2" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editPerangkat2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Perangkat"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Remark -->
    <TextView
        style="@style/FieldLabel"
        android:text="Remark #2" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editRemark2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Catatan"
            android:inputType="textMultiLine"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>