<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Type Rectifier -->
    <TextView
        style="@style/FieldLabel"
        android:text="Type Rectifier #3" />

    <Spinner
        android:id="@+id/spTypeRectifier3"
        style="@style/SpinnerField" />

    <!-- Jumlah Modul & Rusak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="Jumlah Modul" />

            <Spinner
                android:id="@+id/spJumlahModul3"
                style="@style/SpinnerField" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="Modul Rusak" />

            <Spinner
                android:id="@+id/spJumlahModulRusak3"
                style="@style/SpinnerField" />
        </LinearLayout>
    </LinearLayout>

    <!-- Jumlah Battery -->
    <TextView
        style="@style/FieldLabel"
        android:text="Jumlah Battery (P)" />

    <Spinner
        android:id="@+id/spJumlahBattery3"
        style="@style/SpinnerField" />

    <TextView
        style="@style/FieldLabel"
        android:text="Battery Recti 3" />

    <Spinner
        android:id="@+id/spBatteryRecti3"
        style="@style/SpinnerField" />

    <!-- MCB Battery Recty -->
    <TextView
        style="@style/FieldLabel"
        android:text="MCB Battery Recty #3" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editMcbBatteryRecti3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MCB Battery Recty"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Kondisi Arester -->
    <TextView
        style="@style/FieldLabel"
        android:text="Kondisi Arester #3" />

    <Spinner
        android:id="@+id/spKondisiArester3"
        style="@style/SpinnerField" />

    <!-- Bus Voltage -->
    <TextView
        style="@style/FieldLabel"
        android:text="Bus Voltage #3" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editBusVoltage3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bus Voltage"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Load (A) -->
    <TextView
        style="@style/FieldLabel"
        android:text="Load (A) #3" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLoadA3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Load (A)"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Perangkat Terhubung -->
    <TextView
        style="@style/FieldLabel"
        android:text="Perangkat Terhubung #3" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ZamanTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editPerangkat3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Perangkat"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
