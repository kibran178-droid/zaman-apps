<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/GroupLabel" android:text="Tegangan (V)" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout style="@style/ZamanTextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editRV" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="R" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/ZamanTextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_weight="1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editSV" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="S" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/ZamanTextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTV" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="T" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView style="@style/GroupLabel" android:text="Arus (A)" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout style="@style/ZamanTextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editRA" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="R" android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/ZamanTextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_weight="1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editSA" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="S" android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/ZamanTextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTA" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="T" android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

</LinearLayout>